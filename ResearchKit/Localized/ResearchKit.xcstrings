    "SPEECH_IN_NOISE_CALIBRATION_TEXT" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على \"تشغيل الصوت\"، اضبط مستوى الصوت على مستوى مريح لك ثم اضغط على \"إيقاف الصوت\" للمتابعة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prem “Reproduir l’àudio”, ajusta el volum a un nivell agradable i després prem “Aturar l’àudio” per continuar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepněte na Spustit přehrávání, upravte hlasitost na příjemnou úroveň a potom pokračujte klepnutím na Zastavit přehrávání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på “Afspil lyd” for at justere lydstyrken til et behageligt niveau, og tryk derefter på “Stop lyd” for at fortsætte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf „Audio wiedergeben“, um die Lautstärke auf einen angenehmen Pegel einzustellen, und tippe dann auf „Audio stoppen“, um fortzufahren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αγγίξτε «Αναπαραγωγή ήχου», προσαρμόστε τον ήχο σε άνετο επίπεδο και μετά αγγίξτε «Διακοπή ήχου» για να συνεχίσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap 'Play Audio', adjust your volume to a comfortable level and then tap 'Stop Audio' to proceed."
          }
        },
        "en_AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap 'Play Audio', adjust your volume to a comfortable level and then tap 'Stop Audio' to proceed."
          }
        },
        "en_GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap Play Audio, adjust your volume to a comfortable level, and then tap Stop Audio to proceed."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap 'Play Audio', adjust your volume to a comfortable level and then tap 'Stop Audio' to proceed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap Play Audio, adjust your volume to a comfortable level, and then tap Stop Audio to proceed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa “Reproducir audio”, ajusta el volumen a un nivel cómodo y pulsa “Detener audio” para continuar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta Toista ääni, säädä äänenvoimakkuus sopivalle tasolle ja jatka napauttamalla Pysäytä ääni."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tapikin ang 'I-play ang Audio', i-adjust ang iyong volume sa komportableng antas at pagkatapos ay tapikin ang 'Itigil ang Audio' para magpatuloy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez « Écouter », réglez votre volume à un niveau qui vous convient, puis touchez « Arrêter l’audio » pour continuer."
          }
        },
        "fr_CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez « Écouter », réglez votre volume à un niveau qui est confortable, puis touchez « Arrêter l’audio » pour continuer."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez « Écouter », réglez votre volume à un niveau qui est confortable, puis touchez « Arrêter l’audio » pour continuer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקש/י על ״נגן שמע״, התאם/י את עוצמת הקול לרמה הנוחה לך ולאחר מכן הקש/י על ״הפסק שמע״ כדי להמשיך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘ऑडियो चलाएँ' पर टैप करें, आरामदेय स्तर पर अपना वॉल्यूम समायोजित करें और फिर जारी रखने के लिए ‘ऑडियो रोकें' पर टैप करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirnite 'Reproduciraj zvuk', podesite svoju glasnoću na ugodnu razinu i zatim dodirnite 'Zaustavi audio zapis' za nastavak."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppintson a „Hang lejátszása” gombra, állítsa kellemes szintre a hangerőt, majd koppintson a „Hang leállítása” gombra a folytatáshoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk 'Putar Audio', sesuaikan volume Anda hingga terdengar nyaman, lalu ketuk 'Hentikan Audio' untuk melanjutkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca “Riproduci audio”, regola il volume a un livello confortevole, quindi tocca “Interrompi audio” per procedere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“オーディオを再生”をタップして、音量を快適なレベルへ調整してから、“オーディオを停止”をタップして次に進みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'오디오 재생'을 탭하고 편안하게 들릴 때까지 음량을 조절한 다음 '오디오 중단'을 탭하여 진행하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketik ‘Mainkan Audio’, laraskan kelantangan anda kepada paras yang selesa dan kemudian ketik ‘Hentikan Audio’ untuk meneruskan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op 'Speel audio af', zet het volume op een prettig niveau en tik vervolgens op 'Stop audio' om verder te gaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij w Odtwarzaj dźwięk, dostosuj głośność do odpowiedniego poziomu, a potem stuknij w Zatrzymaj dźwięk, aby kontynuować."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em “Reproduzir Áudio”, ajuste o volume para um nível confortável e toque em “Parar Áudio” para prosseguir."
          }
        },
        "pt_PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em “Reproduzir áudio” para ajustar o volume para um nível confortável e, depois, toque em “Parar áudio” para avançar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Toque em 'Reproduzir Áudio', ajuste o volume para um nível confortável e depois toque em 'Parar Áudio' para prosseguir."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em “Reproduzir áudio” para ajustar o volume para um nível confortável e, depois, toque em “Parar áudio” para avançar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apăsați “Redare audio”, ajustați volumul la un nivel confortabil și apoi apăsați “Oprire audio” pentru a continua."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коснитесь «Воспроизвести аудио», отрегулируйте громкость до нужного уровня, а затем коснитесь «Остановить аудио», чтобы продолжить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepnite na Prehrať audio, upravte hlasitosť na primeranú úroveň a potom pokračujte klepnutím na Zastaviť audio."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kiliki i le 'Taaalo Leo', fetu'una'i lou leo i se tulaga lelei ma kiliki le 'Taofi Leo' e fa'aauau ai."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Guji 'Ciyaar Codka', hagaaji muggaaga heer raaxo leh ka dibna guji 'Jooji Codka' si aad u sii socoto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på Spela upp ljud, justera volymen till en behaglig nivå och fortsätt sedan genom att trycka på Stoppa ljud."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gusa 'Cheza Sauti', rekebisha sauti yako hadi kiwango kinachokufaa kisha gusa 'Simamisha Sauti' ili kuendelea."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะ 'เล่นเสียง' แล้วปรับความดังของคุณให้อยู่ในระดับที่พอดี จากนั้นแตะ 'หยุดเสียง' เพื่อดำเนินการต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Sesi Çal”a dokunun, ses yüksekliğini sizi rahatsız etmeyecek bir düzeye ayarlayın ve ardından “Sesi Durdur”a dokunarak ilerleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Торкніть «Відтворити аудіо», установіть комфортний рівень гучності і потім торкніть «Зупинити аудіо», щоб продовжити."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm vào 'Phát âm thanh', điều chỉnh âm lượng đến mức phù hợp và sau đó chạm vào 'Dừng âm thanh' để tiếp tục."
          }
        },
        "zh_CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点“播放音频”，将音量调整至舒适的程度，然后轻点“停止播放音频”以进行下一步。"
          }
        },
        "zh_HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一下「播放音訊」，將音量調整至一個舒適的水平，然後按一下「停止音訊」來繼續。"
          }
        },
        "zh_TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下「播放音訊」，調整至舒適音量，然後點一下「停止音訊」以繼續。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "点击'播放音频'，调整音量至舒适水平，然后点击'停止音频'继续。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
