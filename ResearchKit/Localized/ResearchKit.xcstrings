            "value" : "Activa para iniciar la prueba. Cuando la prueba comience, toca directamente este botón cuando escuches un sonido en tu oído derecho."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I-activate para magsimula ang pagsusuri. Kapag nagsimula na ang pagsusuri, pindutin nang direkta ang butong ito kapag nakarinig ka ng tunog sa iyong kanang tainga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Activer pour démarrer le test. Lorsque le test démarre, appuyez directement sur ce bouton lorsque vous entendez un son dans votre oreille droite."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Activez pour démarrer le test. Lorsque le test commence, appuyez directement sur ce bouton lorsque vous entendez un son dans votre oreille droite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Attiva per iniziare il test. Quando il test inizia, premi direttamente su questo pulsante quando senti un suono nell'orecchio destro."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Activeer om de test te starten. Wanneer de test begint, druk direct op deze knop wanneer je een geluid in je rechteroor hoort."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aktywuj, aby rozpocząć test. Gdy test się rozpocznie, naciśnij bezpośrednio ten przycisk, gdy usłyszysz dźwięk w prawym uchu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ative para iniciar o teste. Quando o teste começar, toque diretamente neste botão quando você ouvir um som no seu ouvido direito."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ative para iniciar o teste. Quando o teste começar, toque diretamente neste botão quando ouvir um som no seu ouvido direito."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Activați pentru a începe testul. Când testul începe, apăsați direct pe acest buton când auziți un sunet în urechea dreaptă."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fa'agaoioi e amata ai le su'ega. A amata le su'ega, tā luga lenei fa'amau pe a e fa'alogoina se leo i lou taliga taumatau."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dhaqaaji si aad u bilowdo tijaabada. Marka tijaabadu bilaabato, riix badhankaan si toos ah marka aad maqasho dhawaq kaga imanaya dhegta midig."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gusa kuwasha ili kuanza mtihani. Wakati mtihani unapoanza, gusa kwa moja kwa moja kitufe hiki unaposikia sauti katika sikio lako la kulia."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kích hoạt để bắt đầu bài kiểm tra. Khi bài kiểm tra bắt đầu, nhấn trực tiếp vào nút này khi bạn nghe thấy âm thanh bên tai phải."
          }
