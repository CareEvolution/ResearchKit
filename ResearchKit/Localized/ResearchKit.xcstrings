    "SHOULDER_RANGE_OF_MOTION_TEXT_INSTRUCTION_1_LEFT" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند البدء ستضع جهازك على كتفك الأيسر لإجراء قياس. الرجاء تشغيل الصوت على جهازك حتى تتمكن من سماع التعليمات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan comencis, et posaràs el dispositiu a sobre de l’espatlla esquerra per prendre una mesura. Activa el so del dispositiu per poder sentir les instruccions."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V dalším kroku budete vyzváni, abyste svoje zařízení přiložili k levému rameni kvůli měření. Zapněte na zařízení zvuk, abyste slyšeli pokyny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du starter, anbringer du din enhed på din venstre skulder for at tage et mål. Slå lyden til på din enhed, så du kan høre instruktioner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn es losgeht, legst du dein Gerät zur Messung auf deine linke Schulter. Bitte schalte bei deinem Gerät den Ton an, damit du die Anweisungen hören kannst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν ξεκινήσετε, θα τοποθετήσετε τη συσκευή στον αριστερό σας ώμο για τη μέτρηση. Αυξήστε την ένταση ήχου στη συσκευή για να ακούσετε τις οδηγίες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you begin you will put your device on your left shoulder for a measurement. Please turn the sound on your device on so you can hear instructions."
          }
        },
        "en_AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you begin you will put your device on your left shoulder for a measurement. Please turn the sound on your device on so you can hear instructions."
          }
        },
        "en_GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you begin, you will put your device on your left shoulder for a measurement. Please turn on the sound on your device so you can hear instructions."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you begin you will put your device on your left shoulder for a measurement. Please turn the sound on your device on so you can hear instructions."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you begin, you will put your device on your left shoulder for a measurement. Please turn on the sound on your device so you can hear instructions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siéntate en el borde de una silla. Cuando estés preparado, colócate el dispositivo en el hombro izquierdo para empezar a medir. Activa el sonido del dispositivo para oír las instrucciones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aloitettaessa laite asetetaan mittausta varten vasemmalle olkapäälle. Laita laitteesi ääni päälle, jotta kuulet ohjeet."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kapag nagsimula ka, ilalagay mo ang iyong aparato sa iyong kaliwang balikat para sa pagsukat. Paki-on ang tunog sa iyong aparato upang marinig mo ang mga instruksyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencez par placer votre appareil sur l’épaule gauche pour prendre une mesure. Veillez à activer le son pour entendre les instructions."
          }
        },
        "fr_CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous débuterez l’activité en plaçant votre appareil sur l’épaule gauche pour effectuer une mesure. Activez le son de votre appareil pour écouter les instructions."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous débuterez l’activité en plaçant votre appareil sur l’épaule gauche pour effectuer une mesure. Activez le son de votre appareil pour écouter les instructions."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בתחילת הפעילות, תצטרך/י להניח את המכשיר על כתף שמאל כדי לבצע מדידות. ודא/י שהצליל במכשיר מופעל כדי שתוכל/י לשמוע את ההנחיות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आरंभ करने पर आपको माप के लिए अपने बाएँ कंधे पर अपना उपकरण रखना होगा। कृपया अपने उपकरण पर ध्वनि चालू करें जिससे आप निर्देश सुन सकें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad započnete, trebat ćete staviti uređaj na lijevo rame radi mjerenja. Molimo, uključite zvuk na uređaju kako biste čuli upute."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Első lépésként tegye az eszközét a bal vállára egy mérés elvégzéséhez. Kapcsolja be a hangot az eszközén, hogy hallja az utasításokat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat Anda memulai, taruh perangkat di bahu kiri Anda untuk pengukuran. Nyalakan bunyi perangkat sehingga Anda dapat mendengar instruksi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All’inizio posizionerai il dispositivo sulla spalla sinistra per una misurazione. Attiva i suoni del dispositivo per poter sentire le istruzioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "始めるときは、測定のためにデバイスを左肩の上に置きます。指示が聞こえるように、デバイスのサウンドをオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실험을 시작하면 측정을 위해 기기를 왼쪽 어깨에 놓아두게 됩니다. 지침을 들을 수 있도록 기기 사운드를 켜두십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila anda bermula anda akan meletakkan peranti anda di atas bahu kiri anda untuk ukuran. Sila aktifkan bunyi pada peranti anda supaya anda boleh dengar arahan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer je begint, plaats je je apparaat op je linkerschouder voor een meting. Schakel het geluid van je apparaat in zodat je instructies kunt horen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na początek umieścisz urządzenie na lewym ramieniu w celu pomiaru. Włącz dźwięk w urządzeniu, aby słyszeć instrukcje."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao começar, você colocará o dispositivo no seu ombro esquerdo para uma medição. Ative o som do dispositivo para poder ouvir as instruções."
          }
        },
        "pt_PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao iniciar, coloque o dispositivo sobre o seu ombro esquerdo para uma medição. Ative o som do dispositivo para poder ouvir as instruções."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ao iniciar, você colocará seu dispositivo no seu ombro esquerdo para medição. Por favor, ligue o som do seu dispositivo para que você possa ouvir as instruções."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao iniciar, coloque o dispositivo sobre o seu ombro esquerdo para uma medição. Ative o som do dispositivo para poder ouvir as instruções."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când începeți, puneți-vă dispozitivul pe umărul stâng pentru măsurătoare. Activați sunetul pe dispozitivul dvs. pentru a auzi instrucțiunile."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сперва положите устройство на левое надплечье, ближе к плечу: это необходимо для оценивания. Включите звук на устройстве для прослушивания инструкций."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na zariadení zapnite zvuk, aby ste počuli pokyny. Po spustení aktivity si na účely merania pridržte zariadenie na ľavom ramene."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A o amataina o le a e tuu lau masini i lou tauau agavale mo se fuataga. Faamolemole ki le leo i lau masini ina ia mafai ai ona e faalogo i faatonuga."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Marka aad bilaabayso waxaad qalabkaaga saari doontaa garabkaaga bidix si aad u cabirto. Fadlan shid dhawaaqa qalabkaaga si aad tilmaamaha u maqasho."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du börjar med att lägga enheten på din vänstra axel så att den kan mätas. Slå på ljudet på enheten så att du kan höra anvisningarna."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utakapoanza utaweka kifaa chako kwenye bega lako la kushoto kwa ajili ya kupima. Tafadhali washa sauti kwenye kifaa chako ili uweze kusikia maelekezo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อคุณเริ่มต้น คุณจะต้องวางอุปกรณ์ของคุณบนไหล่ข้างซ้ายของคุณเพื่อการวัด โปรดเปิดเสียงบนอุปกรณ์ของคุณเพื่อให้คุณสามารถฟังขั้นตอนได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
