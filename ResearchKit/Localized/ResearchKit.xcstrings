    "AX_TONE_AUDIOMETRY_BUTTON_RIGHT_EAR_HINT" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aktivieren Sie, um den Test zu starten. Wenn der Test beginnt, tippen Sie direkt auf diesen Knopf, wenn Sie einen Ton im rechten Ohr hören."
          }
        },
        "en" : {
          "stringUnit" : {
