        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Paced Auditory Serial Addition Test (PASAT) misura la velocità di elaborazione delle informazioni uditive e la capacità di calcolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PASAT（定速聴覚的連続加算）では、聴覚による情報処理速度と計算能力を測定します。"
