    "PSAT_INTRO_TEXT_2_%@" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم عرض أرقام فردية كل %@ من الثواني.\nيجب عليك إضافة كل رقم جديد إلى الرقم الذي يسبقه مباشرةً.\nانتبه، لا يتعين عليك حساب مجموع مستمر، لكن فقط مجموع آخر رقمين."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es presenten números solts cada %@ segons.\nHas de sumar cada nou número al número immediatament anterior.\nAtenció: no has d’anar calculant la suma total, sinó només la suma dels dos últims números."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vždy za %@ s se zobrazí číslice.\nPřičtěte ji k bezprostředně předchozí číslici.\nNesčítejte všechny číslice. Sečtěte jen poslední dvě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der vises enkelte tal hvert %@. sekund.\nDu skal lægge hvert nye tal sammen med tallet lige før det.\nBemærk: Du skal ikke lægge alle tallene sammen, kun de to sidste tal."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle %@ Sekunden werden einzelne Zahlen präsentiert.\nDie musst jede neue Zahl zu der unmittelbar vorhergehenden addieren.\nAchtung, du sollst nicht die Gesamtsumme bilden, sondern nur die Summe der beiden letzten Zahlen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα μονά ψηφία εμφανίζονται κάθε %@ δευτερόλεπτα.\nΠρέπει να προσθέτετε κάθε νέο ψηφίο με το ακριβώς προηγούμενό του.\nΠροσοχή: Δεν πρέπει να υπολογίζετε το ολικό σύνολο, αλλά μόνο το σύνολο των τελευταίων δύο αριθμών."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Single digits are presented every %@ seconds.\nYou must add each new digit to the one immediately prior to it.\nAttention, you mustn't calculate a running total, but only the sum of the last two numbers."
          }
        },
        "en_AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Single digits are presented every %@ seconds.\nYou must add each new digit to the one immediately prior to it.\nAttention, you mustn't calculate a running total, but only the sum of the last two numbers."
          }
        },
        "en_GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Single digits are presented every %@ seconds.\nYou must add each new digit to the one immediately before it.\nNote: you must not calculate a running total, only the sum of the last two numbers."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Single digits are presented every %@ seconds.\nYou must add each new digit to the one immediately prior to it.\nAttention, you mustn't calculate a running total, but only the sum of the last two numbers."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Single digits are presented every %@ seconds.\nYou must add each new digit to the one immediately before it.\nNote: you must not calculate a running total, only the sum of the last two numbers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada %@ segundos se muestra un dígito.\nDebes sumar cada dígito nuevo al anterior.\nAtención: no debes calcular la suma total de todos los dígitos, sino solo la suma de los dos últimos números."
          }
        },
        "es_419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los dígitos únicos se presentan cada %@ segundos.\nDebes sumar cada dígito nuevo al que lo precede inmediatamente.\nNota: No debes calcular un total acumulado; sólo la suma de los últimos dos números."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los dígitos únicos se presentan cada %@ segundos.\nDebes sumar cada dígito nuevo al que lo precede inmediatamente.\nNota: No debes calcular un total acumulado; sólo la suma de los últimos dos números."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksittäisiä numeroita näytetään %@ sekunnin välein.\nKukin uusi numero on lisättävä sitä edeltäneeseen.\nHuomaa, että ei ole tarkoitus laskea jatkuvaa summaa, vaan vain kahden viimeisen numeron summa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ang single digits ay ipinapakita kada %@ segundo.\nKailangan mong idagdag ang bawat bagong digit sa nauna rito agad.\nPansin, hindi mo dapat kalkulahin ang kabuuang running total, kundi ang suma ng huling dalawang numero lang."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des chiffres uniques s’affichent toutes les %@ secondes.\nVous devez ajouter chaque nouveau chiffre à celui qui l’a précédé.\nAttention, vous ne devez pas calculer de total, mais simplement la somme des deux derniers chiffres."
          }
        },
        "fr_CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un chiffre s’affiche toutes les %@ secondes.\nVous devez ajouter chaque nouveau chiffre au chiffre précédent.\nAttention, vous ne devez pas calculer la somme totale, mais bien la somme des deux derniers chiffres."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un chiffre s’affiche toutes les %@ secondes.\nVous devez ajouter chaque nouveau chiffre au chiffre précédent.\nAttention, vous ne devez pas calculer la somme totale, mais bien la somme des deux derniers chiffres."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ספרות בודדות מוצגות כל %@ שניות.\nעליך להוסיף ספרה חדשה אל זו שנמצאת ממש לפניה.\nלתשומת לבך, אין לחשב את הסה״כ המצטבר, אלא רק את סכום שני המספרים האחרונים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एकल अंक प्रति %@ सेकंड में प्रस्तुत किए जाते हैं।\nआपको प्रत्येक नए अंक का उससे ठीक पहले वाले अंक से योग करना है।\nध्यान रखें, आपको कुल योग परिकलित नहीं करना है बल्कि केवल अंतिम दो अंकों का योग परिकलित करना है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednoznamenkaste brojke prikazuju se svakih %@ sekundi.\nMorate pribrojiti svaku novu znamenku onoj koja joj neposredno prethodi.\nPozor, ne smijete računati ukupni iznos, nego samo zbroj posljednja dva broja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ másodpercenként számjegyek jelennek meg.\nMinden új számjegyet adjon hozzá az előtte lévőhöz.\nFigyelem: Ne számítsa ki a teljes sorozat összegét, csak az utolsó két számjegy összegét."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digit tunggal dimunculkan setiap %@ detik.\nAnda harus menambahkan setiap digit baru ke digit sebelumnya.\nIngat, jangan menghitung jumlah total, tapi hanya jumlah dua angka terakhir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le singole cifre vengono mostrate ogni %@ secondi.\nDevi aggiungere ciascuna cifra a quella immediatamente precedente.\nAttenzione, non devi calcolare un totale collettivo, ma solo la somma degli ultimi due numeri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@秒ごとに1つの数字が表示されます。\n表示された数字を、直前に表示された数字と足してください。\nすべての数字を足すのではありません。常に、表示された数字とその直前の数字の2つだけを足してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 자릿수의 숫자가 %@초마다 제시됩니다.\n새로운 숫자가 제시될 때마다 직전에 제시된 숫자에 더하십시오.\n총 누계를 계산하지 않도록 주의하십시오. 직전에 제시된 두 개의 숫자만 더하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digit tunggal dipaparkan setiap %@ saat.\nAnda mesti menambahkan setiap digit baru dengan digit sebelumnya.\nHarap maklum, anda tidak perlu mengira jumlah keseluruhan, tetapi jumlah dua nombor terakhir sahaja."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enkeltsifre vises hvert %@. sekund.\nDu må legge det nye sifferet sammen med det som ble vist rett før.\nMerk at du ikke skal summere alle tallene, bare de to som ble vist sist."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke %@ seconden zie en/of hoor je een cijfer.\nJe moet elk nieuw cijfer optellen bij het vorige cijfer.\nLet op: je moet niet het totaal van alle cijfers berekenen, maar alleen de som van de laatste twee cijfers."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaprezentujemy pojedyncze cyfry zmieniające się po %@ sekundach.\nKażdą nową cyfrę musisz dodać do cyfry poprzedniej.\nUwaga, nie obliczaj łącznej sumy, lecz tylko sumę dwóch ostatnich cyfr."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dígitos únicos são apresentados a cada %@ segundos.\nVocê deve adicionar cada novo dígito ao dígito anterior.\nAtenção, não calcule um total cumulativo, apenas a soma dos últimos dois números."
          }
        },
        "pt_PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dígitos únicos são apresentados a cada %@ segundos.\nTem de adicionar cada novo dígito ao dígito imediatamente anterior.\nAtenção, não deve calcular o valor total, mas apenas a soma dos últimos dois números."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dígitos únicos são apresentados a cada %@ segundos.\nVocê deve adicionar cada novo dígito ao antecessor imediato.\nAtenção, você não deve calcular um total acumulado, mas apenas a soma dos dois últimos números."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dígitos únicos são apresentados a cada %@ segundos.\nTem de adicionar cada novo dígito ao dígito imediatamente anterior.\nAtenção, não deve calcular o valor total, mas apenas a soma dos últimos dois números."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cifrele apar la fiecare %@ secunde.\nTrebuie să adunați fiecare cifră nouă cu cea imediat precedentă.\nAtenție, nu trebuie să calculați suma totală, ci doar suma ultimelor două cifre."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С частотой в %@ с будет показано однозначное число.\nПрибавляйте каждое новое число к предыдущему.\nВнимание! Вычислять общую сумму не нужно — просто складывайте два последних числа."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každé %@ s sa zobrazí nové číslo.\nKaždé nové číslo musíte pripočítať k číslu zobrazenému pred ním.\nPozor, nesmiete počítať celkový súčet týchto čísiel, ale len súčet dvoch posledných čísiel."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O lo'o fa'aalia le numera ta'itasi i le %@ sekone uma.\nE tatau ona e fa'aopoopo le numera fou i le numera sa i ai muamua.\nFa'aeteete, e le tatau ona e fuafuaina le aofa'i atoa, ae na'o le fa'aopoopoina o numera e lua mulimuli."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tirooyin hal lambar ah ayaa la soo bandhigayaa %@ ilbidhiqsi kasta.\nWaa inaad ku dartaa lambar kasta oo cusub midka ka horreeya.\nFiiro gaar ah, waa inaadan xisaabin wadarta socota, kaliya wadarta labada lambar ee ugu dambeeya."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensiffriga tal visas med intervall på %@ sekunder.\nDu måste addera varje nytt tal till talet som visades omedelbart före det.\nObs! Du ska inte beräkna en löpande totalsumma, utan bara summan av de senaste två talen."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namba za tarakimu moja zinaonyeshwa kila baada ya sekunde %@.\nLazima uongeze kila tarakimu mpya kwa ile iliyotangulia moja kwa moja.\nKumbuka, hupaswi kuhesabu jumla inayoendelea, bali jumla ya tarakimu mbili za mwisho tu."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัวเลขหนึ่งหลักจะปรากฏขึ้นทุก %@ วินาที\nคุณต้องเพิ่มตัวเลขใหม่แต่ละตัวไปที่ตัวเลขก่อนหน้านั้นทันที\nโปรดทราบว่าคุณต้องไม่คำนวณผลรวมสะสม แต่ให้คำนวณเฉพาะผลรวมของตัวเลขสองตัวสุดท้ายเท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek basamaklar her%@ saniyede bir gösterilir.\nHer bir yeni basamağı hemen öncesindeki basamağa eklemelisiniz.\nDikkat edin, toplamı değil, yalnızca son iki sayının toplamını hesaplayabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Однорозрядні числа показуються що %@ сек.\nВи маєте додавати кожну нову цифру до цифри, що їй передує.\nЗауважте, що вам треба рахувати не підсумок, що наростає, а лише суму двох останніх чисел."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các số duy nhất được đưa ra cứ %@ giây một lần.\nBạn phải cộng từng số mới với số ngay trước nó.\nLưu ý: bạn không được tính tổng liên tục mà chỉ được tính tổng của hai số sau cùng."
          }
        },
        "zh_CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每隔 %@ 秒钟会显示一个一位数。\n您必须将每个新数字与前面的一个的数字相加。\n注意，您不用计算累加值，只需计算最后两个数字之和。"
          }
        },
        "zh_HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每 %@ 秒會顯示一個個位數字。\n你必須將每個新數字和前一個數字相加。\n請注意，你不用計算累積總數，你只要計算最後兩個數字的總和。"
          }
        },
        "zh_TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每 %@ 秒會顯示單一數字。\n您必須將新的數字與前一個數字相加。\n注意：您不能計算所有的數字總和，只需計算前兩個數字的總和。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "每%@秒展示一个数字。\n你必须将每一个新数字加到前一个数字上。\n注意，你不能计算持续总和，只能计算最后两个数字的和。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每 %@ 秒會顯示一個個位數字。\n你必須將每個新數字和前一個數字相加。\n請注意，你不用計算累積總數，你只要計算最後兩個數字的總和。"
          }
        }
      }
    },
