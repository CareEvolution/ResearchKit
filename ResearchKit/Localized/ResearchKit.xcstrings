    "dBHL_TONE_AUDIOMETRY_ONBOARDING_QUESTION" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدد تفضيلك بخصوص \"الأذن الأفضل\"، إذا كانت هناك أذن أفضل من الأخرى."
          }
        },
        "ca" : {
