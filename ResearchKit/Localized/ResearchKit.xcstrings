        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testul PAVSAT (testul auditiv și vizual pe etape de adunare în serie) măsoară aptitudinile dvs. de calcul și viteza de procesare a informațiilor auditive și vizuale."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В слуховом и визуальном тестах на сложение с заданным темпом измеряются способности обрабатывать аудиальную и визуальную информацию, а также способность к вычислениям."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paced Auditory a Visual Serial Addition Test meria rýchlosť, akou dokážete spracovať a spočítať informácie prijaté prostredníctvom sluchu a zraku."
