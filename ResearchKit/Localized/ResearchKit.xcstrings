        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Teste de Adição Sequencial de Audição Medida processa a velocidade e capacidade de calcular para medir suas informações auditivas."
          }
        },
        "pt_PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O teste PASAT (Paced Auditory Serial Addition Test) mede a velocidade de processamento de informação auditiva e a capacidade de cálculo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Teste de Adição Serial Auditiva Ritmada mede a sua velocidade de processamento de informação auditiva e capacidade de cálculo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O teste PASAT (Paced Auditory Serial Addition Test) mede a velocidade de processamento de informação auditiva e a capacidade de cálculo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testul PAVSAT (testul auditiv pe etape de adunare în serie) măsoară aptitudinile dvs. de calcul și viteza de procesare a informațiilor auditive."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В слуховом тесте на сложение с заданным темпом измеряются способность обрабатывать аудиальную информацию, а также способность к вычислениям."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paced Auditory Serial Addition Test meria rýchlosť, akou dokážete spracovať a spočítať informácie prijaté prostredníctvom sluchu."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O le Su'esu'ega o Fa'aopoopoga Fa'asalalau a le Paced Auditory e fua ai le vave o le gaosiga o fa'amatalaga fa'alogona ma le agava'a fa'akalakalasi."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tijaabada Serial Addition Test ee Paced Auditory waxay cabirtaa xawaarahaaga farsamaynta macluumaadka maqalka iyo awoodda xisaabinta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PASAT (Paced Auditory Serial Addition Test) mäter din auditiva bearbetningshastighet och beräkningsförmåga."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mtihani wa Paced Auditory Serial Addition unapima kasi ya usindikaji wa taarifa za sauti na uwezo wako wa kuhesabu."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การทดสอบความสามารถผ่านการบวกเลขตามความเร็วที่ได้ยินจะประเมินข้อมูลด้านการได้ยินของคุณโดยการประมวลผลความเร็วและความสามารถด้านการคิดคำนวณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempolu İşitsel Toplama Testi, işitsel bilgi işleme hızınızı ve hesaplama becerinizi ölçer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слуховий тест на складання у заданому темпі вимірює швидкість обробки вами слухової інформації та вашу здібність до обчислення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bài Kiểm tra Tính tổng Tuần tự bằng Âm thanh Theo tốc độ đo lường tốc độ xử lý thông tin âm thanh cùng với khả năng tính toán của bạn."
          }
        },
        "zh_CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“步进式听觉累加实验”测量您的听觉信息处理速度和计算能力。"
          }
        },
        "zh_HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定時聽覺連續加法測試（PASAT）可測量你的聽覺資料處理速度及計算能力。"
          }
        },
        "zh_TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連續聽覺序列附加測試（PASAT）會測量您的聽覺資訊處理速度和計算能力。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "步调听觉连加测试测量你的听觉信息处理速度和计算能力。"
          }
        },
        "zh-HK" : {
