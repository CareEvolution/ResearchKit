        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 동안 일직선으로 왔다 갔다 걸으십시오. 평상시 걷는 것처럼 걸으면 됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berjalan mundar mandir dalam garis lurus selama %@. Jalan seperti biasa anda lakukan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå fram og tilbake i en rett linje i %@. Gå så normalt så mulig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loop %@ in een rechte lijn heen en weer. Loop zoals je altijd loopt."
