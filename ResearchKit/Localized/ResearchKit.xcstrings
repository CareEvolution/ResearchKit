        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kävele suoraa reittiä edestakaisin %@. Kävele, kuten kävelisit tavallisesti."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Maglakad pabalik-balik sa isang tuwid na linya para sa %@. Maglakad nang normal."
