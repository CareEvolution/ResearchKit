    "AX_TAPPING_INSTRUCTION_VOICEOVER" : {
      "comment" : "This contains the visual text, followed by a VoiceOver-specific description.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Mit VoiceOver erforschen Sie den Bildschirm durch Berührung, um zu lernen, wo sich die Tasten befinden. Aktivieren Sie eine der Tasten, damit die Tasten direkt tappable sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Using VoiceOver, explore the screen by touch to learn where the buttons are located. Activate either button to make the buttons directly tappable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Usa VoiceOver para explorar la pantalla por tacto y aprender dónde están ubicados los botones. Activa cualquiera de los botones para poder tocarlos directamente."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Gamit ang VoiceOver, tuklasin ang screen sa pamamagitan ng paghipo upang malaman kung saan matatagpuan ang mga pindutan. I-activate ang alinmang pindutan upang direktang matapik ang mga pindutan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ En utilisant VoiceOver, explorez l'écran par toucher pour apprendre où se trouvent les boutons. Activez l'un ou l'autre bouton pour rendre les boutons directement tapotables."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ À l'aide de VoiceOver, explorez l'écran par le toucher pour savoir où sont situés les boutons. Activez l'un ou l'autre bouton pour que les boutons soient directement tapotables."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Utilizzando VoiceOver, esplora lo schermo al tatto per imparare dove sono posizionati i pulsanti. Attiva uno qualsiasi dei pulsanti per rendere i pulsanti direttamente tappabili."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Verken met VoiceOver het scherm door aanraking om te leren waar de knoppen zich bevinden. Activeer een van de knoppen om de knoppen direct tappable te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Używając VoiceOver, przeszukaj ekran dotykiem, aby dowiedzieć się, gdzie znajdują się przyciski. Aktywuj którykolwiek przycisk, aby móc bezpośrednio na niego nacisnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Usando o VoiceOver, explore a tela pelo toque para aprender onde os botões estão localizados. Ative qualquer botão para tornar os botões diretamente tocáveis."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Usando o VoiceOver, explore o ecrã pelo toque para aprender onde os botões estão localizados. Ative qualquer botão para tornar os botões diretamente tocáveis."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Utilizând VoiceOver, explorați ecranul prin atingere pentru a afla unde sunt amplasate butoanele. Activați oricare buton pentru a face butoanele direct accesibile prin atingere."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Fa'aoga le VoiceOver, su'esu'e le lau i le pa'i e a'oa'o ai po'o fea o iai fa'amau. Fa'aola so'o se fa'amau e mafai ai ona o'o sa'o i fa'amau."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Adigoo isticmaalaya VoiceOver, sahamin shaashadda adigoo taabanaya si aad u ogaato meesha badhamada ku yaallaan. Firfircooni badhan kasta si toos ah loo garaaci karo badhamada."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Kwa kutumia VoiceOver, gusa skrini kwa kugundua mahali kitufe kilipo. Washa kitufe chochote ili kufanya vitufe viweze kubonyezwa moja kwa moja."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Sử dụng VoiceOver, khám phá màn hình bằng cách chạm để tìm hiểu vị trí của các nút. Kích hoạt bất kỳ nút nào để có thể nhấn trực tiếp các nút."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 使用VoiceOver，通过触摸探索屏幕，了解按钮的位置。激活任一按钮，以使按钮可以直接轻触。"
          }
        }
      }
    },
    "AX_TONE_AUDIOMETRY_BUTTON_LEFT_EAR_HINT" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aktivieren, um den Test zu starten. Wenn der Test beginnt, drücken Sie direkt auf diesen Knopf, wenn Sie ein Geräusch im linken Ohr hören."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activate to start the test. When the test starts, tap directly on this button when you hear a sound in your left ear."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Activa para iniciar la prueba. Cuando la prueba comienza, presiona directamente este botón cuando escuches un sonido en tu oído izquierdo."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I-activate para magsimula ang test. Pag nagsimula na ang test, pindutin ang button na ito kapag nakarinig ka ng tunog sa iyong kaliwang tenga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Activez pour commencer le test. Lorsque le test démarre, appuyez directement sur ce bouton lorsque vous entendez un son dans votre oreille gauche."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Activez pour commencer le test. Lorsque le test commence, appuyez directement sur ce bouton lorsque vous entendez un son dans votre oreille gauche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Attiva per iniziare il test. Quando il test inizia, premi direttamente su questo pulsante quando senti un suono nell'orecchio sinistro."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Activeer om de test te starten. Druk direct op deze knop wanneer u een geluid in uw linker oor hoort zodra de test begint."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aktywuj, aby rozpocząć test. Gdy test się zacznie, naciśnij bezpośrednio ten przycisk, gdy usłyszysz dźwięk w lewym uchu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ative para iniciar o teste. Quando o teste começar, toque diretamente neste botão quando você ouvir um som no seu ouvido esquerdo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ative para iniciar o teste. Quando o teste começar, toque diretamente neste botão quando ouvir um som no seu ouvido esquerdo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Activează pentru a începe testul. Când testul începe, apasă direct pe acest buton când auzi un sunet în urechea stângă."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Faʻagaoioi e amata ai le suʻega. A o amata le suʻega, kiliki saʻo i lenei faʻamau pe a e faʻalogo i se leo i lou taliga agavale."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kicin si aad u bilowdo imtixaanka. Marka imtixaanku bilaabmo, riix badhankaan si toos ah marka aad maqasho dhawaaq ka yimaada dhagtaada bidix."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bonyeza ili kuanza mtihani. Unaposikia sauti kwenye sikio lako la kushoto baada ya mtihani kuanza, gonga kitufe hiki moja kwa moja."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kích hoạt để bắt đầu bài kiểm tra. Khi bài kiểm tra bắt đầu, hãy nhấn trực tiếp vào nút này khi bạn nghe thấy âm thanh ở tai trái."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "激活以开始测试。当测试开始时，如果您在左耳听到声音，请直接按下此按钮。"
          }
        }
      }
    },
