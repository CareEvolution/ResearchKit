    "dBHL_TONE_AUDIOMETRY_INTRO_TEXT" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأكد من تعيين مستوى صوت الجهاز على الحد الأقصى.\n\nأثناء هذه المهمة، سيتم تشغيل نغمة رقيقة في الأذن اليسرى أو اليمنى.\n\nاستمع بعناية واضغط على الزر في كل مرة تسمع فيها النغمة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprova que el volum del dispositiu estigui al nivell màxim.\n\nDurant aquesta tasca, es reproduirà un so subtil a l’orella esquerra o dreta.\n\nEscolta atentament i prem el botó cada vegada que sentis un so."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ujistěte se, že je hlasitost zařízení nastavena na nejvyšší úroveň.\n\nBěhem této úlohy vám v levém nebo pravém uchu bude znít jemný zvuk.\n\nPozorně naslouchejte a pokaždé, když uslyšíte zvuk, klepněte na tlačítko."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sørg for, at enhedens lydstyrke er skruet helt op.\n\nUnder denne opgave afspilles en diskret tone i enten venstre eller højre øre.\n\nLyt godt efter, og tryk på knappen, hver gang du hører en tone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergewissere dich, dass die Gerätelautstärke auf den höchsten Pegel eingestellt ist.\n\nWährend dieser Aufgabe wird ein leiser Ton im linken oder rechten Ohr abgespielt.\n\nHöre genau zu und tippe jedes Mal auf die Taste, wenn du einen Ton hörst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βεβαιωθείτε ότι η ένταση ήχου της συσκευής είναι στο μέγιστο επίπεδο.\n\nΚατά τη διάρκεια αυτής της δραστηριότητας, θα αναπαραχθεί ένας απαλός ήχος είτε στο αριστερό είτε στο δεξιό αφτί.\n\nΑκούστε προσεκτικά και αγγίξτε το κουμπί κάθε φορά που ακούτε έναν τόνο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure the device volume is set to the maximum level.\n\nDuring this task, a subtle tone will play in either the left or right ear.\n\nListen carefully and tap the button every time you hear a tone."
          }
        },
        "en_AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure the device volume is set to the maximum level.\n\nDuring this task, a subtle tone will play in either the left or right ear.\n\nListen carefully and tap the button every time you hear a tone."
          }
        },
        "en_GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure the device volume is set to the maximum level.\n\nDuring this task, a subtle tone will play in either the left or right ear.\n\nListen carefully and tap the button every time you hear a tone."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure the device volume is set to the maximum level.\n\nDuring this task, a subtle tone will play in either the left or right ear.\n\nListen carefully and tap the button every time you hear a tone."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure the device volume is set to the maximum level.\n\nDuring this task, a subtle tone will play in either the left or right ear.\n\nListen carefully and tap the button every time you hear a tone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba que el volumen del dispositivo está al máximo nivel.\n\nDurante esta tarea, se reproducirá un tono sutil en el oído izquierdo o derecho.\n\nEscucha con atención y pulsa el botón cada vez que oigas un tono."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmista, että laitteen äänenvoimakkuus on asetettu suurimpaan arvoonsa.\n\nTämän tehtävän aikana hiljainen ääni toistetaan joko vasempaan tai oikeaan korvaan.\n\nKuuntele tarkasti ja napauta painiketta aina, kun kuulet äänen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Siguraduhing itakda ang dami ng aparato sa pinakamataas na antas.\n\nSa panahon ng gawain na ito, magpapatugtog ng mahinang tono sa kaliwa o kanang tenga.\n\nMakinig nang mabuti at pindutin ang buton tuwing makakarinig ka ng tono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assurez-vous que le volume de l’appareil est au maximum.\n\nPendant cette tâche, un son subtil sera joué dans votre oreille de gauche ou de droite.\n\nÉcoutez avec attention et touchez le bouton chaque fois que vous entendez un son."
          }
        },
        "fr_CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assurez-vous que le volume de l’appareil soit réglé au niveau le plus élevé.\n\nPendant cette tâche, une tonalité subtile se fera entendre soit dans l’oreille droite ou la gauche.\n\nÉcoutez avec attention et touchez le bouton chaque fois que vous entendez une tonalité."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assurez-vous que le volume de l’appareil soit réglé au niveau le plus élevé.\n\nPendant cette tâche, une tonalité subtile se fera entendre soit dans l’oreille droite ou la gauche.\n\nÉcoutez avec attention et touchez le bouton chaque fois que vous entendez une tonalité."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ודא/י שעוצמת הקול של המכשיר הוגדרה לעוצמה המקסימלית.\n\nבמהלך משימה זו, יישמע צליל עדין באוזן שמאל או באוזן ימין.\n\nהאזן/י בקפידה והקש/י על הכפתור בכל פעם שהינך שומע/ת צליל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुनिश्चित करें कि उपकरण का वॉल्यूम अधिकतम स्तर पर सेट है।\n\nइस परीक्षण के दौरान या तो बाएँ या दाएँ कान में हल्की टोन बजाई जाएगी।\n\nध्यान से सुनें और हर बार टोन सुनाई देने पर बटन पर टैप करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provjerite je li glasnoća uređaja podešena na maksimalnu razinu.\n\nTijekom ovog zadatka u lijevom ili desnom uhu reproducirat će se suptilan ton.\n\nSlušajte pažljivo i dodirnite tipku svaki put kad začujete ton."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Győződjön meg róla, hogy az eszköz hangereje a maximális szintre van állítva.\n\nA feladat alatt egy halk hang lesz lejátszva a bal vagy jobb fülében.\n\nHallgasson figyelmesen, és minden alkalommal koppintson a gombra, amikor hangot hall."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastikan volume perangkat diatur ke level maksimum.\n\nSelama tugas ini, nada halus akan diputar di telinga kiri atau kanan.\n\nDengarkan dengan seksama dan ketuk tombol setiap kali Anda mendengar nada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assicurati che il volume del dispositivo sia impostato sul livello massimo.\n\nDurante l'attività, verrà riprodotto un tenue segnale acustico nell'orecchio sinistro o nell'orecchio destro.\n\nAscolta con attenzione e tocca il pulsante ogni volta che senti un segnale acustico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスの音量が最大レベルまで設定されていることを確認してください。\n\nこのタスクの間に、かすかな音が左耳か右耳のどちらかに流れます。\n\n耳を澄ませて、音が聞こえるたびにボタンをタップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기 음량을 최대로 설정했는지 확인하십시오.\n\n이 실험을 진행하는 동안 감지하기 힘든 소리가 왼쪽 귀나 오른쪽 귀에 각각 재생됩니다.\n\n잘 듣고 소리가 들릴 때마다 버튼을 탭하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastikan kelantangan peranti disetkan ke paras maksimum.\n\nSemasa tugas ini, nada lembut akan dimainkan di telinga kiri atau kanan.\n\nDengar dengan teliti dan ketik butang setiap kali anda mendengar nada."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zorg ervoor dat het volume van het apparaat op het hoogste niveau is ingesteld.\n\nTijdens deze taak wordt er een subtiele toon afgespeeld in het linker- of rechteroor.\n\nLuister aandachtig en tik telkens wanneer je een toon hoort op de knop."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw głośność urządzenia na maksymalny poziom.\n\nPodczas tego zadania w lewym lub prawym uchu będzie odtwarzany delikatny dźwięk.\n\nSłuchaj uważnie i za każdym razem, gdy usłyszysz ten dźwięk, stuknij w przycisk."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique se o volume do dispositivo está ajustado ao máximo.\n\nDurante esta tarefa, será reproduzido um som sutil no ouvido esquerdo ou direito.\n\nOuça com atenção e toque no botão sempre que ouvir um som."
          }
        },
        "pt_PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certifique‑se de que o volume do dispositivo está no máximo.\n\nDurante esta tarefa, um som subtil será reproduzido no ouvido esquerdo ou direito.\n\nOuça atentamente e toque no botão sempre que ouvir um som."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Certifique-se de que o volume do dispositivo esteja ajustado para o nível máximo.\n\nDurante esta tarefa, um tom sutil será tocado no ouvido esquerdo ou direito.\n\nEscute atentamente e toque no botão sempre que ouvir um tom."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certifique‑se de que o volume do dispositivo está no máximo.\n\nDurante esta tarefa, um som subtil será reproduzido no ouvido esquerdo ou direito.\n\nOuça atentamente e toque no botão sempre que ouvir um som."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asigurați-vă că volumul dispozitivului este la nivel maxim.\n\nPe durata sarcinii va fi redat un ton subtil în urechea stângă sau dreaptă.\n\nAscultați cu atenție și apăsați butonul de fiecare dată când auziți un ton."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убедитесь, что установлена максимальная громкость устройства.\n\nВо время выполнения задания Вы услышите слабый звук с правой или левой стороны.\n\nСлушайте внимательно и касайтесь кнопки каждый раз, когда слышите звук."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uistite sa, že hlasitosť zariadenia je nastavená na maximum.\n\nPočas tejto úlohy budete v ľavom alebo pravom uchu počuť slabý tón.\n\nPočúvajte pozorne a vždy, keď začujete tón, klepnite na tlačidlo."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ia mautinoa o le leo o le masini ua seti i le tulaga maualuga.\n\nI le taimi o lenei galuega, o le a ta'alo se leo mama i le taliga tauagavale po'o le taliga taumatau.\n\nFa'alogo lelei ma tipi le fa'amau i taimi uma e te fa'alogoina ai se leo."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hubi in mugga qalabka lagu dejiyo heerka ugu sarreeya.\n\nInta lagu guda jiro hawshan, dhawaq khafiif ah ayaa ka ciyaari doona midigta ama bidixda.\n\nSi taxaddar leh u dhageyso oo taabo badhanka markasta oo aad maqasho dhawaq."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se till att ljudet på enheten är inställt på högsta volym.\n\nUnder den här uppgiften kommer en subtil ton att spelas i antingen det högra eller vänstra örat.\n\nLyssna noga och tryck på knappen varje gång du hör en ton."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hakikisha sauti ya kifaa imewekwa kwenye kiwango cha juu kabisa.\n\nKatika zoezi hili, sauti ndogo itacheza katika sikio la kushoto au kulia.\n\nSikiliza kwa makini na uchape kitufe kila mara unaposikia sauti."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจสอบให้แน่ใจว่าได้ตั้งค่าความดังของอุปกรณ์เป็นระดับสูงสุดแล้ว\n\nในบททดสอบนี้ จะมีเสียงเบาๆ เล่นในหูข้างซ้ายหรือข้างขวา\n\nตั้งใจฟังให้ดี แล้วแตะปุ่มทุกครั้งที่คุณได้ยินเสียง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aygıt sesinin en yüksek düzeye ayarlandığından emin olun.\n\nBu görev sırasında, sol veya sağ kulakta hafif bir ses çalacaktır.\n\nDikkatli bir şekilde dinleyin ve sesi her duyduğunuzda düğmeye dokunun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Упевніться, що задано максимальний рівень гучності.\n\nПід час цього завдання в ліве або праве вухо буде відтворюватися ледь чутний сигнал.\n\nУважно слухайте і торкайте кнопку, щоразу як чуєте сигнал."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đảm bảo rằng âm lượng của thiết bị được đặt ở mức tối đa.\n\nTrong phần này, một âm báo nhỏ sẽ phát ở tai bên trái hoặc bên phải.\n\nNghe cẩn thận và chạm vào nút mỗi lần bạn nghe thấy một âm báo."
          }
        },
        "zh_CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确保设备的音量已设为最高。\n\n在本任务过程中，将在左耳或右耳播放柔和的音调。\n\n请仔细听并在每次听到音调时轻点按钮。"
          }
        },
        "zh_HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請確定裝置音量已設定為最大聲。\n\n在此測試活動中，會在左耳或右耳播放一個微細的音調。\n\n細心聆聽並在每次聽到音調時點一下按鈕。"
          }
        },
        "zh_TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確定裝置音量已設到最大聲。\n\n此任務期間，會在左耳或右耳播放微弱的音調。\n\n請仔細聆聽，並在每次聽到音調時點一下按鈕。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "确保设备音量设置为最大级别。\n\n在此任务期间，将在左耳或右耳播放一个微妙的音调。\n\n仔细聆听，并在每次听到音调时点击按钮。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請確定裝置音量已設定為最大聲。\n\n在此測試活動中，會在左耳或右耳播放一個微細的音調。\n\n細心聆聽並在每次聽到音調時點一下按鈕。"
          }
        }
      }
    },
