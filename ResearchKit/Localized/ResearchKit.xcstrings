        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найдите место, где Вы можете безопасно пройти %ld шагов по прямой линии без посторонней помощи."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nájdite si miesto, kde môžete bez cudzej pomoci bezpečne prejsť rovno %ld krokov."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Saili se nofoaga e mafai ai ona e savali saogalemu e aunoa ma se fesoasoani mo le tusa o %ld laʻasaga i se laina saʻo."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hel meel aad si badbaado leh ugu socon karto adigoon cidna caawimaad ka helin qiyaastii %ld tallaabo oo toosan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitta en plats där du säkert kan gå ungefär %ld steg i en rak linje utan hjälp."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pata mahali ambapo unaweza kutembea salama bila msaada kwa takriban hatua %ld mfululizo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ค้นหาที่ที่คุณสามารถเดินเป็นเส้นตรงได้ไกลประมาณ %ld ก้าวได้อย่างปลอดภัยโดยไม่ต้องมีสิ่งช่วยเหลือ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düz bir çizgide yaklaşık %ld adım yardımsız, güvenli bir şekilde yürüyebileceğiniz bir yer bulun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знайдіть місце, де ви можете безпечно зробити %ld кроків по прямій без допомоги."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tìm một nơi mà bạn có thể đi bộ an toàn, không cần có sự hỗ trợ, trong khoảng %ld bước theo đường thẳng."
          }
        },
        "zh_CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在步行安全区域（无外力辅助条件下）直线行走大约 %ld 步。"
          }
        },
        "zh_HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找一個安全的地方，讓你可以不靠輔助地直線步行大約 %ld 步。"
          }
        },
        "zh_TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請找到一個地方可讓您獨立安全地直線步行 %ld 步。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "找一个地方，你可以安全地独自直线行走大约%ld步。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找一個安全的地方，讓你可以不靠輔助地直線步行大約 %ld 步。"
          }
