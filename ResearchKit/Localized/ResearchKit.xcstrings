    "STROOP_TASK_INTRO1_DETAIL_TEXT" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في كل مرة تظهر فيها كلمة، حدد الحرف الثاني من اسم اللون الذي يظهر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada cop que aparegui una paraula, selecciona la primera lletra del nom del COLOR que es mostra."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vždy, když se objeví slovo, vyberte první písmeno BARVY, kterou je slovo napsáno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver gang der vises et ord, skal du vælge de(t) første bogstav(er) i navnet på den viste FARVE."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle jedes Mal, wenn ein Wort erscheint, den ersten Buchstaben der FARBE aus, die angezeigt wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
