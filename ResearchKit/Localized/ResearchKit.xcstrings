    "SPEECH_IN_NOISE_STEP_TEXT" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم تشغيل جملة لمرة واحدة، وهي جملة مختلطة بضوضاء في الخلفية بقيمة عشوائية لمعدل الإشارة إلى الضوضاء (SNR)."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es reproduirà només una vegada una frase amb soroll de fons en una relació senyal‑soroll (SNR) aleatòria."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Věta smíchaná s hlukem na pozadí při náhodném poměru signál-šum (SNR) bude přehrána jen jednou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En sætning, der er blandet med baggrundsstøj i et tilfældigt signal-støj-forhold (SNR) afspilles kun en gang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Satz, der bei einer zufälligen SNR-Rate (Signal-to-Noise-Ratio) mit Hintergrundgeräuschen gemischt wurde, wird einmal abgespielt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα αναπαραχθεί μόνο μία φορά μια πρόταση με θόρυβο στο παρασκήνιο σε τυχαιοποιημένο SNR (λόγος σήματος προς θόρυβο)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sentence mixed with background noise at a randomized Signal to Noise Ratio (SNR) will be played only once."
          }
        },
        "en_AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sentence mixed with background noise at a randomised Signal to Noise Ratio (SNR) will be played only once."
          }
        },
        "en_GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sentence mixed with background noise at a randomised Signal to Noise Ratio (SNR) will be played only once."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sentence mixed with background noise at a randomised Signal to Noise Ratio (SNR) will be played only once."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sentence mixed with background noise at a randomised Signal to Noise Ratio (SNR) will be played only once."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se reproducirá una frase mezclada con ruido de fondo a una relación señal/ruido (S/R) aleatorizada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Virke, johon on sekoitettu taustakohinaa satunnaisessa signaali-kohinasuhteessa (SNR), toistetaan vain kerran."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Isang pangungusap na hinaluan ng ingay sa likuran sa isang pinalabong Signal to Noise Ratio (SNR) ay ipapalabas nang minsan lamang."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une phrase avec du bruit de fond sera lue une seule fois, à un rapport signal sur bruit aléatoire."
          }
        },
        "fr_CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une phrase mélangée à du bruit de fond ayant un rapport signal/bruit (RSB) réparti au hasard ne se fera entendre qu’une seule fois."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une phrase mélangée à du bruit de fond ayant un rapport signal/bruit (RSB) réparti au hasard ne se fera entendre qu’une seule fois."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משפט המשולב עם רעש רקע בעל יחס אות לרעש (SNR) אקראי יושמע פעם אחת בלבד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पृष्ठभूमि के शोर के साथ अनियमित नॉइज़ अनुपात सिग्नल (SNR) पर मिश्रित वाक्य को केवल एक बार चलाया जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rečenica pomiješana s pozadinskom bukom po nasumično odabranom Omjeru signala i šuma (SNR) reproducirat će se samo jednom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy véletlenszerű jel-zaj arányú (SNR) háttérzajjal kevert mondat lesz egyetlen alkalommal lejátszva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalimat yang dicampur dengan kebisingan latar belakang pada Rasio Sinyal terhadap Kebisingan (SNR) yang acak hanya akan diputar sekali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrà riprodotta una frase con rumore di fondo con un rapporto segnale/rumore casuale una sola volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ランダムなSN比（SNR）で背景ノイズと混ざった文章が一度だけ再生されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무작위의 SNR(신호 대 잡음비)로 주변의 소음이 혼합된 문장이 한 번만 재생됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayat bercampur dengan hingar latar belakang pada Nisbah Isyarat kepada Hingar (SNR) yang dirawakkan akan dimainkan hanya sekali."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wordt slechts eenmaal een zin afgespeeld, waarbij achtergrondgeluid met een willekeurige signaal-ruisverhouding hoorbaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdanie z szumem w tle z losowym stosunkiem sygnału do szumu (SNR) zostanie odczytane tylko raz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma frase mesclada com ruído de fundo em Razão Sinal-Ruído (RSR) será reproduzida somente uma vez."
          }
        },
        "pt_PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma frase misturada com ruído de fundo será reproduzida, apenas uma vez, com um rácio sinal/ruído (SNR) aleatório."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uma frase com ruído de fundo em uma Razão Sinal-Ruído (SNR) aleatória será reproduzida apenas uma vez."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma frase misturada com ruído de fundo será reproduzida, apenas uma vez, com um rácio sinal/ruído (SNR) aleatório."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Va fi redată o singură dată o propoziție combinată cu zgomot de fundal la un raport semnal/zgomot (SNR) randomizat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предложение, записанное на фоне шума и с измененным отношением сигнала к шуму, будет воспроизведено один раз."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahrávka vety skombinovanej so šumom na pozadí a náhodným pomerom signálu k šumu (SNR) bude prehraná len raz."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O le fuai’upu e fefiloi i le pisapisao i tua i le Fuataga ole Pisapisao ole Fa’asalaga (SNR) e le mafai ona toe taina se ia toe taina."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "needs_review",
