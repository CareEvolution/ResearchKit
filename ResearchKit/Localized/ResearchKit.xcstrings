        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נער/י את המכשיר בכיוון כלשהו ברגע שהנקודה הכחולה מופיעה על המסך. תתבקש/י לעשות זאת %D פעמים."
