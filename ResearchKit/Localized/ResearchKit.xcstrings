    "PASAT_INTRO_TEXT" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقيس اختبار الجمع المتوالى السمعى المتواتر سرعة معالجة المعلومات السمعية والقدرة الحسابية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El PAST (test auditiu de suma en sèrie a ritme) mesura la teva velocitat de processament d’informació auditiva i la teva habilitat de càlcul."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paced Auditory a Serial Addition Test měří vaši rychlost a počtářské dovednosti při zpracovávání sluchových informací."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PASAT-testen måler, hvor hurtigt du behandler lydoplysninger og din evne til at foretage udregninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der akustische Serienaddiertest mit Zeitlimit (PASAT, Paced Auditory Serial Addition Test) misst, wie schnell du akustische Informationen verarbeiten und rechnen kannst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η δοκιμασία PASAT (Βηματική ακουστική πρόσθεση αριθμών σε σειρά) αξιολογεί την ταχύτητα ακουστικής επεξεργασίας πληροφοριών και την ικανότητα υπολογισμών."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Paced Auditory Serial Addition Test measures your auditory information processing speed and calculation ability."
          }
        },
        "en_AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Paced Auditory Serial Addition Test measures your auditory information processing speed and calculation ability."
          }
        },
        "en_GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Paced Auditory Serial Addition Test measures your auditory information processing speed and calculation ability."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
