        "sm" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gatete le masini i so'o se fa'atonuga pe a tula'i mai le togi lanumoana i luga o le lau. O le a fesiligia oe e faia lenei mea %D taimi."
