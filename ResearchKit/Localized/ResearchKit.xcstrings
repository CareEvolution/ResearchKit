        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las %@ se irán iluminando de una en una. Pulsa las %@ en el mismo orden en el que se han iluminado."
          }
        },
        "es_419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas imágenes de %@ se encenderán una a la vez. Toca las imágenes de %@ en el mismo orden en que se encendieron."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas imágenes de %@ se encenderán una a la vez. Toca las imágenes de %@ en el mismo orden en que se encendieron."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näet yksi kerrallaan syttyviä %@. Napauta %@ samassa järjestyksessä kuin ne syttyivät."
