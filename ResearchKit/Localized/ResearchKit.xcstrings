        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met de PASAT (een stapsgewijze auditieve seriële opteltest) wordt gemeten hoe snel je hoorbare informatie verwerkt en hoe goed je kunt rekenen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
