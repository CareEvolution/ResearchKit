          "stringUnit" : {
            "state" : "translated",
            "value" : "Pre spustenie klepnite na Ďalej."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kiliki le isi e amata."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Taabo Xiga si aad u bilowdo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på Nästa för att börja."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gusa Kitufe kinachofuata kuanza."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะถัดไปเพื่อเริ่ม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başlamak için İleri’ye dokunun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Торкніть «Далі», щоб почати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm Tiếp để bắt đầu."
          }
        },
        "zh_CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点“下一步”来开始。"
          }
