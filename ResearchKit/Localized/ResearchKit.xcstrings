    "WALK_BACK_AND_FORTH_INSTRUCTION_FORMAT" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بالمشي ذهابًا وإيابًا في خط مستقيم %@. قم بالمشي كما تفعل عادةً."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vés i torna caminant en línia recta durant %@. Camina naturalment."
