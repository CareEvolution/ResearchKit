        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PASAT 테스트(Paced Auditory Serial Addition Test)는 사용자의 청각 정보 처리 속도 및 계산 능력을 측정합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
