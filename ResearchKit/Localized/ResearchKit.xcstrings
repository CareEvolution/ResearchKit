    "TASK_COMPLETE_TEXT" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم تحليل بياناتك وسيتم إعلامك عندما تصبح النتائج جاهزة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’analitzaran les dades i rebràs una notificació quan tinguis els resultats a punt."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data budou analyzována a jakmile budou k dispozici výsledky, obdržíte oznámení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine data vil blive analyseret, og du får besked, når resultaterne er klar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten werden analysiert und du wirst benachrichtigt, wenn deine Ergebnisse bereitstehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
