            "value" : "Cammina avanti e indietro in linea retta per %@. Cammina come faresti normalmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まっすぐ行ったり来たりして%@間歩きます。いつもと同じように歩いてください。"
