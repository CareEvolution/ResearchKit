    "AX_dBHL_TONE_AUDIOMETRY_INTRO_TEXT" : {
      "comment" : "This contains the visual text, followed by a VoiceOver-specific description.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Mit VoiceOver ist die Schaltfläche direkt tappbar. Sie befindet sich in der Nähe der Mitte des Bildschirms."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Using VoiceOver, the button will be directly tappable. It will be located near the center of the screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Usando VoiceOver, el botón será directamente pulsable. Estará ubicado cerca del centro de la pantalla."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Gamit ang VoiceOver, direktang matatap ang button. Ito ay matatagpuan malapit sa gitna ng screen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ En utilisant VoiceOver, le bouton sera directement tappable. Il sera situé près du centre de l'écran."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ En utilisant VoiceOver, le bouton sera directement tapable. Il sera situé près du centre de l'écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Utilizzando VoiceOver, il pulsante sarà direttamente tappabile. Sarà situato vicino al centro dello schermo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Met VoiceOver kan de knop direct worden getikt. Het bevindt zich dichtbij het midden van het scherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Korzystając z VoiceOver, przycisk będzie bezpośrednio dostępny do stuknięcia. Znajdzie się blisko środka ekranu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Usando o VoiceOver, o botão poderá ser tocado diretamente. Estará localizado perto do centro da tela."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Usando o VoiceOver, o botão pode ser tocado diretamente. Estará localizado perto do centro do ecrã."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Folosind VoiceOver, butonul poate fi atins direct. Va fi situat aproape de centrul ecranului."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Faʻaaogaina le VoiceOver, e mafai ona faʻapipiʻi saʻo le faʻamau. O le a tu i le ogatotonu o le lau."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Iyada oo la isticmaalayo VoiceOver, badhanka si toos ah ayaa loo taaban karaa. Waxay ku taallaa meel u dhow bartamaha shaashadda."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Ukutumia VoiceOver, kitufe kitaweza kuguswa moja kwa moja. Kitakuwa kimepangwa karibu na katikati ya skrini."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Sử dụng VoiceOver, nút sẽ được chạm trực tiếp. Nó sẽ được đặt gần trung tâm màn hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 使用VoiceOver，按钮可以直接点击。它将位于屏幕中心附近。"
          }
        }
      }
    },
