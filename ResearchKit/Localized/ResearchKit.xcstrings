        "so" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Imtixaanka Ku-darista Taxanaha Maqalka iyo Muuqaalka ee Xawaaraha waxa uu cabirayaa xawaaraha howsha macluumaadka maqalka iyo muuqaalka iyo awoodda xisaabinta."
