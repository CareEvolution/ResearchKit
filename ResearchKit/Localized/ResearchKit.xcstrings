        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otestovaná bude vaša ľavá aj pravá ruka.\nČo najrýchlejšie vezmite kolík, umiestnite do otvoru %@-krát a potom ho vytiahnite taktiež %@-krát."
