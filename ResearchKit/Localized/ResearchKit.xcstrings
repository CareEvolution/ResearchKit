          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrząśnij urządzeniem w dowolnym kierunku, gdy tylko zobaczysz na ekranie niebieską kropkę. Test zostanie powtórzony %D razy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agite o dispositivo em qualquer direção assim que o ponto azul aparecer na tela. Você será solicitado a fazer isso %D vezes."
