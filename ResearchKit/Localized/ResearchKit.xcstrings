          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PASAT-testen (Paced Auditory Serial Addition Test) måler hvor raskt du behandler lydinformasjon og evnen din til å gjøre utregninger."
