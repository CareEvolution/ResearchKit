    "TONE_AUDIOMETRY_PREP_TEXT" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من المفترض أن تسمع نغمة الآن. اضبط مستوى الصوت باستخدام عناصر التحكم على جانب الجهاز.\n\nاضغط على أي زر عندما تكون مستعدًا للبدء."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ara hauries d’escoltar un so. Ajusta el volum amb els controls de la part lateral del dispositiu.\n\nPrem qualsevol botó quan estiguis a punt per començar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Měli byste slyšet tón. Jeho hlasitost upravte ovládacími prvky na boku zařízení.\n\nAž budete připraveni začít, klepněte na kterékoli tlačítko."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du skulle nu høre en tone. Juster lydstyrken med knapperne på siden af din enhed.\n\nTryk på en knap, når du er klar til at starte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du solltest jetzt einen Ton hören. Passe die Lautstärke mit den Steuerelementen an der Seite deines Geräts an.\n\nTippe auf eine Taste, wenn du beginnen möchtest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τώρα θα ακούσετε έναν τόνο. Προσαρμόστε την ένταση ήχου με τα χειριστήρια που βρίσκονται στην πλαϊνή πλευρά της συσκευής σας.\n\nΑγγίξτε οποιοδήποτε κουμπί όταν είστε έτοιμοι να ξεκινήσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You should now hear a tone. Adjust the volume using the controls on the side of your device.\n\nTap any button when you are ready to begin."
          }
        },
        "en_AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You should now hear a tone. Adjust the volume using the controls on the side of your device.\n\nTap any button when you are ready to begin."
          }
        },
        "en_GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You should now hear a tone. Adjust the volume using the controls on the side of your device.\n\nTap any button when you are ready to begin."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You should now hear a tone. Adjust the volume using the controls on the side of your device.\n\nTap any button when you are ready to begin."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You should now hear a tone. Adjust the volume using the controls on the side of your device.\n\nTap any button when you are ready to begin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora deberías oír un tono. Ajusta el volumen con los controles laterales del dispositivo.\n\nPulsa cualquier botón cuando estés listo para empezar."
          }
        },
        "es_419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debes escuchar un tono ahora. Ajusta el volumen con los controles laterales de tu dispositivo.\n\nToca el botón cuando quieras comenzar."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debes escuchar un tono ahora. Ajusta el volumen con los controles laterales de tu dispositivo.\n\nToca el botón cuando quieras comenzar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinun pitäisi nyt kuulla ääni. Säädä voimakkuutta laitteen sivussa olevilla säätimillä.\n\nNapauta jotakin painiketta kun olet valmis aloittamaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dapat marinig mo na ngayon ang isang tono. I-adjust ang volume gamit ang mga kontrol sa gilid ng iyong aparato.\n\nTapikin ang anumang button kapag handa ka nang magsimula."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous devriez maintenant entendre un son. Réglez le volume à l’aide des commandes situées sur le côté de l’appareil.\n\nTouchez n’importe quel bouton quand vous êtes prêt à commencer."
          }
        },
        "fr_CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous devriez maintenant entendre un son. Réglez le volume en utilisant les boutons latéraux de votre appareil.\n\nTouchez n’importe quel bouton lorsque vous êtes prêt."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous devriez maintenant entendre un son. Réglez le volume en utilisant les boutons latéraux de votre appareil.\n\nTouchez n’importe quel bouton lorsque vous êtes prêt."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כעת מושמע צליל. התאם/י את עוצמת השמע לפי הצורך באמצעות כפתורי עוצמת השמע בצד המכשיר.\n\nהקש/י על כפתור כלשהו כדי להתחיל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अब आपको एक टोन सुनाई देनी चाहिए। अपने उपकरण के किनारे दिए गए नियंत्रणों का उपयोग करके वॉल्यूम समायोजित करें।\n\nजब आप आरंभ करने के लिए तैयार हो जाएँ, तो किसी भी बटन पर टैप करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sad biste trebali začuti ton. Kontrolama s bočne strane svog uređaja podesite glasnoću.\n\nKad ste spremni započeti dodirnite bilo koju tipku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ön most valószínűleg hall egy hangot. Állítsa be a hangerőt az eszköz oldalán található vezérlőkkel.\n\nKoppintson egy gombra, amikor készen áll a kezdésre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seharusnya Anda telah mendengar nada sekarang. Sesuaikan volume menggunakan kontrol di sisi perangkat Anda.\n\nKetuk tombol mana pun setelah Anda siap memulai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora sentirai un segnale acustico, regola il volume mediante i tasti laterali del tuo dispositivo.\n\nTocca un pulsante per iniziare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音が聞こえてくるのでデバイスの横にあるコントロールで音量を調整してください。\n\n始める準備ができたらボタンをタップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 소리가 들립니다. 기기 측면에 있는 제어기를 사용하여 음량을 조절하십시오.\n\n시작할 준비가 되었으면 아무 버튼이나 탭하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda sepatutnya mendengar nada sekarang. Laraskan kelantangan menggunakan kawalan di sisi peranti anda.\n\nKetik sebarang butang apabila anda bersedia untuk bermula."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bør nå høre en tone. Juster volumet med kontrollene på siden av enheten.\n\nTrykk på knappen når du er klar til å begynne."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je moet nu een toon horen. Pas het volume aan met de knoppen aan de zijkant van je apparaat.\n\nTik op een willekeurige knop wanneer je klaar bent om te beginnen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teraz usłyszysz dźwięk. Ustaw głośność urządzenia używając przycisków bocznych.\n\nAby rozpocząć, naciśnij dowolny klawisz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agora você deverá ouvir um tom. Ajuste o volume usando os controles na lateral do seu dispositivo.\n\nToque em qualquer botão quando você estiver pronto para começar."
          }
        },
        "pt_PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deve ouvir um som agora. Ajuste o volume usando os controlos na parte lateral do dispositivo.\n\nToque em qualquer botão quando estiver pronto para começar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Você deve agora ouvir um tom. Ajuste o volume usando os controles ao lado do seu dispositivo.\n\nToque em qualquer botão quando estiver pronto para começar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deve ouvir um som agora. Ajuste o volume usando os controlos na parte lateral do dispositivo.\n\nToque em qualquer botão quando estiver pronto para começar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ar trebui să auziți acum un ton. Ajustați volumul folosind comenzile de pe lateralul dispozitivului.\n\nApăsați orice buton când sunteți gata de a începe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сейчас Вы должны слышать сигнал. Отрегулируйте громкость при помощи боковых кнопок устройства.\n\nКоснитесь любой кнопки, когда будете готовы начать."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teraz by ste mali počuť tón. Nastavte hlasitosť pomocou ovládacích prvkov na bočnej strane zariadenia.\n\nKeď budete pripravení začať, klepnite na ľubovoľné tlačidlo."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "E tatau ona e fa'alogoina se leo. Fetu'una'i le leo e ala i le fa'aogaina o pulega i itu o lau masini.\n\nTā so'o se ki pe a e sauni e amata."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Waa inaad hadda maqashaa dhawaaq. Ku hagaaji mugga adiga oo adeegsanaya kontaroolada dhinaca qalabkaaga.\n\nTaabo badhan kasta markaad diyaar tahay inaad bilowdo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu bör du höra en ton. Justera volymen med reglagen på sidan av enheten.\n\nTryck på någon av knapparna när du vill börja."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sasa unapaswa kusikia sauti. Rekebisha sauti kwa kutumia vidhibiti vilivyo upande wa kifaa chako.\n\nBonyeza kitufe chochote unapokuwa tayari kuanza."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตอนนี้คุณควรจะได้ยินเสียงเตือน ให้ปรับความดังเสียงโดยใช้ตัวควบคุมที่อยู่ด้านข้างอุปกรณ์ของคุณ\n\nแตะปุ่มใดก็ได้เมื่อคุณพร้อมที่จะเริ่มต้นแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimdi bir ses duymalısınız. Aygıtınızın yan tarafındaki denetimleri kullanarak ses düzeyini ayarlayın.\n\nBaşlamaya hazır olduğunuzda herhangi bir düğmeye dokunun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зараз ви маєте почути тональний сигнал. Регулюйте гучність кнопками на боці свого пристрою.\n\nТоркніть будь-яку кнопку на екрані, щоб розпочати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bây giờ bạn sẽ nghe thấy một âm báo. Điều chỉnh âm lượng bằng cách điều khiển ở sườn của thiết bị.\n\nChạm vào bất kỳ nút nào khi bạn đã sẵn sàng bắt đầu."
          }
        },
        "zh_CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在您应该听到一个音调。使用设备一侧的控制来调整音量。\n\n请在准备好后，轻点任意按钮来开始测试。"
          }
        },
        "zh_HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你現在會聽到一個聲調。使用裝置側邊的控制項目來調整音量。\n\n當你準備好開始時，請按一下任何按鈕。"
          }
        },
        "zh_TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您現在應該可聽到測試音。請使用裝置側邊的控制按鈕來調整音量。\n\n當您準備好開始時，請點任一個按鈕。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "现在你应该能听到一个音调。使用设备侧面的控制调节音量。\n\n准备好开始时点任意按钮。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你現在會聽到一個聲調。使用裝置側邊的控制項目來調整音量。\n\n當你準備好開始時，請按一下任何按鈕。"
          }
        }
      }
    },
