    "AX_TONE_AUDIOMETRY_PREP_TEXT_VOICEOVER" : {
      "comment" : "This contains the visual text, followed by a VoiceOver-specific description, followed by the visual text on the following page (since VoiceOver users may not have a chance to hear the visual text before needing to perform the actions).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Verwenden Sie VoiceOver, um den Bildschirm durch Berührung zu erkunden und zu erfahren, wo die Tasten für jedes Ohr sich befinden. Wenn der Test beginnt, werden die Tasten direkt tippbar sein. %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Using VoiceOver, explore the screen by touch to learn where the buttons for each ear are located. When the test starts, the buttons will be directly tappable. %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Usando VoiceOver, explora la pantalla mediante el tacto para aprender dónde están ubicados los botones de cada oído. Cuando comience la prueba, los botones serán directamente tappables. %@"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Gamit ang VoiceOver, galugarin ang screen sa pamamagitan ng pag-touch para malaman kung saan matatagpuan ang mga pindutan para sa bawat tainga. Kapag nagsimula na ang pagsusulit, direktang matatapik ang mga pindutan. %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Utilisez VoiceOver pour explorer l'écran par toucher et apprendre où sont situés les boutons pour chaque oreille. Lorsque le test commence, les boutons seront directement tappables. %@"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ En utilisant VoiceOver, explorez l'écran par toucher pour découvrir où sont situés les boutons pour chaque oreille. Lorsque le test commence, les boutons seront directement tappables. %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Usando VoiceOver, esplora lo schermo tramite tocco per scoprire dove si trovano i pulsanti per ogni orecchio. Quando inizia il test, i pulsanti saranno direttamente tappabili. %@"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Met VoiceOver, verken het scherm met aanraking om te leren waar de knoppen voor elk oor zich bevinden. Als de test begint, zullen de knoppen direct tappable zijn. %@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Korzystając z VoiceOver, zwiedzaj ekran za pomocą dotyku, aby dowiedzieć się, gdzie znajdują się przyciski dla każdego ucha. Gdy test się zacznie, przyciski będą bezpośrednio tappable. %@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Usando o VoiceOver, explore a tela por toque para aprender onde os botões para cada ouvido estão localizados. Quando o teste começar, os botões serão diretamente tappables. %@"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Usando VoiceOver, explore o ecrã através do toque para aprender a localização dos botões para cada orelha. Quando o teste começar, os botões serão diretamente tappáveis. %@"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Folosind VoiceOver, explorați ecranul prin atingere pentru a învăța unde sunt situate butoanele pentru fiecare ureche. Când începe testul, butoanele vor putea fi apăsate direct. %@"
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Fa'aogaina le VoiceOver, su'e le lau i le tago e a'oa'o ai le mea o iai i fa'amau mo vaega taitasi o le taliga. Pe a amata le su'ega, o le a tuusa'o ona pa'i atu i fa'amau. %@"
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Isticmaalka VoiceOver, baadh shaashadda adigoo taabanaya si aad u ogaato meesha batoonada dhegaha mid walba ay ku yaalliin. Marka uu tijaabada bilaabmo, batoonada si toos ah ayaa loo taaban karaa. %@"
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Tumia VoiceOver, gusa skrini kujifunza mahali pa vifungo kwa kila sikio. Wakati mtihani unapoanza, vifungo vitaweza kuguswa moja kwa moja. %@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Sử dụng VoiceOver, khám phá màn hình bằng cách chạm để biết vị trí các nút cho mỗi tai. Khi bắt đầu kiểm tra, các nút sẽ có thể được nhấn trực tiếp. %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 使用VoiceOver，通过触摸探索屏幕以了解每个耳朵的按钮位置。测试开始时，按钮将可以直接点击。%@"
          }
        }
      }
    },
