    "SPATIAL_SPAN_MEMORY_INTRO_2_TEXT_%@" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستضيء بعض ال%@ كلٌ على حدة. اضغط على هذه ال%@ بنفس ترتيب إضاءتها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunes de les %@ s’il·luminaran d’una en una. Prem les %@ en qüestió en l’ordre en què s’hagin il·luminat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Některé %@ se postupně rozsvítí. Klepejte na %@ v pořadí, ve kterém se rozsvěcovaly."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nogle af %@ne vil blinke en ad gangen. Tryk på %@ne i den samme rækkefølge, som de blinker i."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige der %@ werden der Reihe nach aufleuchten. Tippe in derselben Reihenfolge auf diese %@."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάποιες από τις %@ θα φωτίζονται μία-μία. Αγγίξτε αυτές τις %@ με την ίδια σειρά με αυτήν που φωτίστηκαν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some of the %@ will light up one at a time. Tap those %@ in the same order they lit up."
          }
        },
        "en_AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some of the %@ will light up one at a time. Tap those %@ in the same order they lit up."
          }
        },
        "en_GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some of the %@ will light up one at a time. Tap those %@ in the same order they lit up."
          }
        },
        "en-AU" : {
          "stringUnit" : {
