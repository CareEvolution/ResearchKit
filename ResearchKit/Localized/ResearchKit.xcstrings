        },
        "sm" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O le Suega Fa'aopoopoga Fa'asologa o Fa'alogo ma Mata'o fa'atatauina le saoasaoa o lau fa'agasologa o fa'amatalaga fa'alogo ma le agava'a tau fuainumera."
